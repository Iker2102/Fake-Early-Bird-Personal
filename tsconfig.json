{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        "rootDir": "./src",
        "outDir": "./dist",

        "strict": true,

        "esModuleInterop": true,
        "skipLibCheck": true,

        "lib": ["ES2022"],
        "types": ["node"]
    },

    "include": ["src"],

    "exclude": [
        "tests",
        "dist",
        "node_modules"
    ]
}