PORT=3000

DB_PATH=./data/app.db

WA_SESSION_PATH=./.wwebjs_auth
WA_RECONNECT_MAX_ATTEMPTS=5
WA_RECONNECT_BASE_DELAY_SECONDS=5

TZ=Europe/Madrid
WORK_HOURS_START=8
WORK_HOURS_END=19
HOLIDAYS=2026-01-01,2026-01-06,2026-05-01,2026-10-12,2026-12-25

SMTP_HOST=HOST
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=USER
SMTP_PASS=PASSWORD
SMTP_FROM=CONTACT FORM
NOTIFY_EMAIL=EMAIL
NOTIFY_ON_DISCONNECT=true

WA_ENABLED=true

RANDOM_DELAY_MIN_SECONDS=30
RANDOM_DELAY_MAX_SECONDS=180
TYPING_BASE_DELAY_MS=1000
TYPING_MS_PER_CHAR=40

CONTACT_COOLDOWN_MINUTES=10
MAX_MESSAGES_PER_CONTACT_PER_DAY=3
SCHEDULE_VARIATION_MINUTES=5

DELIVERY_TIMEOUT_MINUTES=10

RETRY_MAX=3

NOTIFY_ON_SUCCESS=true

LOG_LEVEL=info